<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.prometheus.money.mapper.WordsMapper">
	<!-- 嵌套查询 -->
	<select id="countDistinctWords" resultType="java.lang.Integer">
		SELECT COUNT(*)
		FROM (
		SELECT DISTINCT word
		FROM words
		WHERE series IN
		<foreach collection="seriesList" item="series" open="("
			separator="," close=")">
			#{series}
		</foreach>
		AND season IN
		<foreach collection="seasonList" item="season" open="("
			separator="," close=")">
			#{season}
		</foreach>
		AND episode IN
		<foreach collection="episodeList" item="episode" open="("
			separator="," close=")">
			#{episode}
		</foreach>
		) AS sub_query
	</select>
	
	<insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO words(word,series,season,episode)
        VALUES
        <foreach collection="wordList" item="word" separator=",">
            (#{word.word},#{word.series},#{word.season},#{word.episode})
        </foreach>
    </insert>
    
	
	<select id="getWordCount" resultType="com.prometheus.money.entity.transfer.vo.WordDo">
        SELECT word, COUNT(*) AS frequency
        FROM words 
        GROUP BY word 
        ORDER BY frequency DESC
    </select>
</mapper>
